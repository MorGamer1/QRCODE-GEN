# Copy this file to .env and fill in the values marked REQUIRED before running
# `docker compose up -d --build`. Everything else has a sane default for a first run.
#
# .env is gitignored - it holds real secrets. Never commit it.

# -----------------------------------------------------------------------------------------
# Core URLs
# -----------------------------------------------------------------------------------------
# The address people will actually use to reach this server. Also the origin QR codes' short
# redirect URLs are built against (https://qr.example.com/r/AbC123), and the base that
# S3_PUBLIC_URL derives from below - get this right before generating QR codes, since static
# QR codes bake it directly into the printed image.
PUBLIC_BASE_URL=http://localhost

# Origin(s) allowed to call the API with credentials (comma-separated if more than one). For
# the bundled nginx setup this is the same address as PUBLIC_BASE_URL.
WEB_BASE_URL=http://localhost

# Host port nginx binds to. Change if 80 is already taken on this machine.
NGINX_HTTP_PORT=80

# -----------------------------------------------------------------------------------------
# Postgres (REQUIRED)
# -----------------------------------------------------------------------------------------
POSTGRES_USER=qrgen
POSTGRES_PASSWORD=changeme
POSTGRES_DB=qrgen

# -----------------------------------------------------------------------------------------
# Redis (REQUIRED)
# -----------------------------------------------------------------------------------------
REDIS_PASSWORD=changeme

# -----------------------------------------------------------------------------------------
# Secrets (REQUIRED) - each must be at least 32 characters, and must be UNIQUE to your
# deployment. Generate real ones with:
#   openssl rand -base64 32
# The app refuses to start with anything shorter than 32 characters, so the placeholders
# below are deliberately too short rather than shipping a real-looking default every
# deployment might forget to change.
# -----------------------------------------------------------------------------------------
JWT_ACCESS_SECRET=changeme
JWT_REFRESH_SECRET=changeme
COOKIE_SECRET=changeme

# -----------------------------------------------------------------------------------------
# Object storage (REQUIRED) - defaults to the bundled MinIO service (see the `minio` and
# `minio-init` services in docker-compose.yml). To use real AWS S3 / Cloudflare R2 /
# Backblaze B2 / etc instead, override S3_ENDPOINT below and set these to that provider's
# credentials - you can then comment out the minio/minio-init services in docker-compose.yml.
# -----------------------------------------------------------------------------------------
S3_ACCESS_KEY_ID=qrgen-minio
S3_SECRET_ACCESS_KEY=changeme-min-8-chars
S3_BUCKET=qrgen
# S3_ENDPOINT=https://s3.your-provider.example
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true
# Public URL prefix uploaded files are served from. Defaults to "$PUBLIC_BASE_URL/files/$S3_BUCKET"
# (nginx proxies /files/ straight to the bundled MinIO, see infra/docker/nginx/conf.d/default.conf).
# Set this explicitly if you're using external S3/R2/B2 with its own public bucket URL instead.
# S3_PUBLIC_URL=https://cdn.example.com/qrgen

# -----------------------------------------------------------------------------------------
# Email (optional) - required for verification emails, password reset, and scan alert
# notifications. Leave blank to run without outbound email.
# -----------------------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=QR Code Generator <no-reply@example.com>
# SMTP_SECURE=false

# -----------------------------------------------------------------------------------------
# OAuth sign-in (optional) - the login page only shows a provider's button once both of its
# vars below are set (see GET /api/v1/auth/config).
# -----------------------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost/api/v1/auth/google/callback

# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost/api/v1/auth/github/callback

# -----------------------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------------------
TWO_FACTOR_ISSUER=QR Code Generator
LOG_LEVEL=log
