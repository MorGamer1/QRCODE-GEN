{
  "name": "@qrgen/qr-engine",
  "version": "1.0.0",
  "private": true,
  "description": "High-quality SVG-based QR code generation and styling engine",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "lint": "eslint src --config ../../eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@qrgen/shared": "workspace:*",
    "pdfkit": "^0.15.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "svg-to-pdfkit": "^0.1.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.13.5",
    "@types/qrcode": "^1.5.5",
    "@zxing/library": "^0.23.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
