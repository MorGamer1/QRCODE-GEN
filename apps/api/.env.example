# Local (non-Docker) dev: `pnpm dev` reads this via apps/api/.env. Values here match the
# infra docker-compose.dev.yml spins up (`docker compose -f docker-compose.dev.yml up -d`),
# so copying this file as-is is enough to get `pnpm dev` talking to it - no edits needed.
#
# This is NOT used by the production docker-compose.yml, which builds the same env vars
# itself from the root .env.example instead. Copy to apps/api/.env - it's gitignored.

NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://postgres:qrgen_dev_password@localhost:5432/qrgen?schema=public"
REDIS_URL="redis://localhost:6379"

PUBLIC_BASE_URL="http://localhost:4000"
WEB_BASE_URL="http://localhost:3000"

# Dev-only placeholders - fine to use as-is locally, never reuse these in a real deployment.
JWT_ACCESS_SECRET="dev-jwt-access-secret-change-in-production-00"
JWT_REFRESH_SECRET="dev-jwt-refresh-secret-change-in-production-0"
COOKIE_SECRET="dev-cookie-secret-change-in-production-00000000"

S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="devkey"
S3_SECRET_ACCESS_KEY="devsecret"
S3_BUCKET="qrgen-dev"
