{
  "name": "@qrgen/api",
  "version": "1.0.0",
  "private": true,
  "description": "QR Code Generator platform - REST API, redirect engine and analytics worker",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "dev:worker": "nest start worker --watch",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint src --config ../../eslint.config.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "clean": "rm -rf dist .turbo",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@qrgen/shared": "workspace:*",
    "@qrgen/qr-engine": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/schedule": "^4.1.2",
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.34.6",
    "ioredis": "^5.4.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-google-oauth20": "^2.0.0",
    "passport-github2": "^0.1.12",
    "nestjs-zod": "^4.3.1",
    "zod": "^3.24.1",
    "argon2": "^0.41.1",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "helmet": "^8.0.0",
    "cookie-parser": "^1.4.7",
    "geoip-lite": "^1.4.10",
    "ua-parser-js": "^1.0.40",
    "nodemailer": "^6.9.16",
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/s3-request-presigner": "^3.716.0",
    "multer": "1.4.5-lts.1",
    "file-type": "^16.5.4",
    "sharp": "^0.33.5",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-github2": "^1.2.9",
    "@types/cookie-parser": "^1.4.8",
    "@types/geoip-lite": "^1.4.4",
    "@types/ua-parser-js": "^0.7.39",
    "@types/nodemailer": "^6.4.17",
    "@types/multer": "^1.4.12",
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.2",
    "dotenv": "^16.4.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "supertest": "^7.0.0",
    "prisma": "^5.22.0",
    "typescript": "^5.7.2"
  }
}
