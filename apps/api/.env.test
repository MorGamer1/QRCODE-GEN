# Used by `pnpm test:e2e` (see test/setup-e2e.ts) and CI (see .github/workflows). Deliberately
# committed (unlike .env) - it holds no real secrets, only fixed values a throwaway test run
# needs. Points at a dedicated qrgen_test database so e2e runs never touch dev data.

NODE_ENV=test
PORT=4100

DATABASE_URL="postgresql://postgres:qrgen_dev_password@localhost:5432/qrgen_test?schema=public"
REDIS_URL="redis://localhost:6379/1"

PUBLIC_BASE_URL="http://localhost:4100"
WEB_BASE_URL="http://localhost:3000"

JWT_ACCESS_SECRET="e2e-test-jwt-access-secret-not-for-production"
JWT_REFRESH_SECRET="e2e-test-jwt-refresh-secret-not-for-production"
COOKIE_SECRET="e2e-test-cookie-secret-not-for-production-0000"

# Not exercised by the e2e suite (file upload requires a real S3-compatible endpoint, which
# isn't available in this environment - see docs/DEPLOYMENT.md) - only present so env
# validation passes at boot.
S3_ENDPOINT="http://localhost:19000"
S3_ACCESS_KEY_ID="test-key"
S3_SECRET_ACCESS_KEY="test-secret"
S3_BUCKET="qrgen-test"

LOG_LEVEL="error"
